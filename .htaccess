# موقع النقب الإخباري — .htaccess

# حماية الملفات الحساسة
# نكتب الصيغتين: Apache 2.4 (Require) و 2.2 (Order/Deny) حتى يعمل الملف
# على أي سيرفر دون الاعتماد على وحدة mod_access_compat.
<FilesMatch "^(config\.php|config\.example\.php|db\.php|auth\.php|functions\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# منع تصفح المجلدات
Options -Indexes

# حماية مجلد includes
<IfModule mod_rewrite.c>
    RewriteEngine On

    # منع الوصول المباشر لمجلد includes
    RewriteRule ^includes/ - [F,L]

    # ضغط GZIP
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
    </IfModule>

    # كاش للملفات الثابتة
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresByType image/jpeg "access plus 1 month"
        ExpiresByType image/png "access plus 1 month"
        ExpiresByType image/webp "access plus 1 month"
        ExpiresByType image/gif "access plus 1 month"
        ExpiresByType text/css "access plus 1 week"
        ExpiresByType application/javascript "access plus 1 week"
    </IfModule>
</IfModule>

# حماية من الوصول لملفات النظام
<FilesMatch "\.(env|log|sql|md|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# منع الوصول لمجلد .git لو رُفع بالخطأ (يكشف كامل تاريخ الكود)
RedirectMatch 404 /\.git

# ترميز UTF-8
AddDefaultCharset UTF-8

# حماية الهيدرات
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
