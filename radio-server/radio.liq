# راديو النقب — إعداد Liquidsoap
#
# وظيفته: يشغّل الأغاني على مدار الساعة، ولما يتصل مذيع أو مذيعان بالمايك
# يتحوّل البث لصوتهما (مخلوطَين إن كانا اثنين) فوراً، ولما يفصلا يرجع للأغاني
# لحاله. وكمان يستقبل أوامر من لوحة تحكم الموقع (شغّل هذا المقطع الآن / المجدولة).
#
# المسار على السيرفر: /srv/radio/radio.liq
# افحص الملف قبل التشغيل:  liquidsoap --check /srv/radio/radio.liq

# ===== كلمات السر =====
# ⬇️ غيّر الثلاث. الأولى نفسها الموجودة في icecast.xml (<source-password>).
# كلمتا المذيعين يجب أن تختلفا عن بعضهما — الفصل بينهما هو ما يعطي كل مذيع
# هوية مستقلة، فتُسحب صلاحية أحدهما أو تُعرف مصدر مشكلة دون المساس بالآخر.
icecast_pass = "غيّر_كلمة_سر_icecast"
live_pass    = "غيّر_كلمة_سر_المذيع_الأول"
live2_pass   = "غيّر_كلمة_سر_المذيع_الثاني"

# ===== قناة التحكم =====
# لوحة التحكم بالموقع تبعث أوامرها عبر هذا السوكيت (requests.push وغيره).
# سوكيت ملفّي لا منفذ شبكة، فلا ينفتح على الإنترنت إطلاقاً. الصلاحية 0660
# ليتمكّن مستخدم PHP (www-data، وهو عضو بمجموعة liquidsoap) من الكتابة فيه.
settings.server.socket := true
settings.server.socket.path := "/srv/radio/liquidsoap.sock"
settings.server.socket.permissions := 0o660

# ===== معرّف البلاي ليست الفعّالة حالياً =====
# متغيّر تفاعلي تقرأه وتكتبه لوحة التحكم عبر السوكيت (var.get / var.set) فقط،
# ليعرف الموقع أي بلاي ليست محمّلة الآن دون حاجة لتخمينها من اسم الملف.
# لا يُستعمل في منطق هذا الملف؛ إن حذّر Liquidsoap من عدم استعماله فتجاهل التحذير.
active_playlist = interactive.string("active_playlist", "0")

# ===== الأغاني (التشغيل التلقائي) =====
# المصدر ملف قائمة .m3u لا مجلد: لوحة التحكم تشتقّه من بلاي ليست قاعدة
# البيانات وتستبدل مساره بالكامل (لا محتواه) عبر music.uri عند كل تبديل.
# mode="normal" = ترتيب تسلسلي كقائمة يوتيوب، يعيد من الأول بعد آخر مقطع.
# reload_mode="watch" يلتقط أي تعديل على الملف نفسه فوراً بدون إعادة تشغيل.
# المسار الابتدائي default.m3u تكتبه PHP دائماً بمحتوى البلاي ليست الافتراضية،
# فبعد أي إعادة تشغيل للمحرّك يبدأ البث بها مباشرة قبل أن يصحّح المشغّل الحالة.
music = playlist(id = "music", mode = "normal", reload_mode = "watch", "/srv/radio/playlists/default.m3u")

# mksafe يضمن ألا يتوقف البث لو كانت القائمة فارغة أو تعذّر قراءة ملف
music = mksafe(music)

# ===== طابور الطلبات =====
# لوحة التحكم تدفع فيه مقاطع لتشتغل فوراً عبر الأمر: requests.push <مسار>
# وهو نفسه مصدر المقاطع المجدولة زمنياً (cron/radio-scheduler.php).
requests = request.queue(id = "requests")

# ===== مدخلا المذيعين المباشرين =====
# برنامج المذيع الأول (BUTT) يتصل على هذا المنفذ بالـ mountpoint اسمه /live
# كما كان دائماً — الاسم والمنفذ لم يتغيّرا فلا ينكسر إعداد المذيع الحالي.
# المذيع الثاني يتصل على منفذ وmountpoint مستقلّين بكلمة سرّه الخاصة.
#
# المعرّف id هنا صريح ومقصود: بدونه يسمّي Liquidsoap كل input.harbor تلقائياً
# (input.harbor أو input.harbor.1 وهكذا)، فتصير أسماء أوامر الحالة على السوكيت
# غير متوقّعة وقد تتضارب بين المصدرين، ولا يعود الموقع يعرف من على الهواء.
# بالمعرّفات الصريحة تصير الأسماء ثابتة ومقروءة: live1.status و live2.status.
live1 = input.harbor(id = "live1", "live",  port = 8005, password = live_pass)
live2 = input.harbor(id = "live2", "live2", port = 8006, password = live2_pass)

# ===== خلط المذيعين =====
# normalize = false إلزامي هنا: القيمة الافتراضية (true) تقسم المستوى على عدد
# المصادر المتّصلة فعلياً، فدخول المذيع الثاني يُسقط صوت الأول قرابة 6 ديسيبل
# فجأة، ثم يعيدها عند خروجه — قفزة مسموعة عند كل انضمام وانفصال. بإيقاف
# التسوية التلقائية يبقى مستوى كل مذيع ثابتاً بغضّ النظر عمّن يتكلّم معه.
#
# لماذا fallback حول add لا add مجرّداً: السؤال البنيوي هنا هو هل يبقى add
# متاحاً حين يتصل مذيع واحد فقط. لا محرّك متاح هنا لاختبار هذه الدلالة، وكلا
# الاحتمالين يُبقي البث سليماً مع هذا الشكل:
#   - إن كان add متاحاً بتوفّر أيٍّ من مصدريه ⇒ hosts يعمل بمذيع واحد أو
#     اثنين، ويفوز كفرع أول في fallback فيُسمع الخليط الصحيح في كل الحالات.
#   - إن اشترط add توفّر الاثنين معاً ⇒ hosts يصير غير متاح كلّما اتصل مذيع
#     واحد فقط، فيسقط fallback تلقائياً إلى live1 أو live2 أيّهما متصل — لا
#     صمت ولا كسر، فقط بلا خلط لأنه لا يوجد ما يُخلط أصلاً.
# النتيجتان مقبولتان؛ ما لا يجوز حدوثه هو صمت تام رغم اتصال مذيع واحد على
# الأقل — وهذا ما يفحصه اختبار القبول أدناه.
hosts = add(normalize = false, [live1, live2])
live  = fallback(track_sensitive = false, [hosts, live1, live2])

# ===== الأولوية =====
# البث المدمج للمذيعين يعلو على كل شي، ثم الطلبات/المجدول، ثم الأغاني العادية.
# بنية الأولوية نفسها لم تتغيّر — المدخل المباشر صار مخلوطاً بدل مفرد فقط.
# track_sensitive = false : التحويل فوري ولا ينتظر انتهاء المقطع الحالي
radio = fallback(track_sensitive = false, [live, requests, music])

# ===== اختبار القبول (نفّذه يدوياً بعد النشر، لا يشغّله هذا الملف) =====
# 1) بلا أي مذيع متصل يجب أن تُسمع الموسيقى. لو سُمع صمت فمعناه أن add صار
#    متاحاً دائماً وابتلع الأولوية — أوقف كل شيء وارجع للنسخة السابقة فوراً.
# 2) اتصال مذيع واحد (live1 أو live2) ⇒ يُسمع صوته وحده.
# 3) اتصال الثاني أثناء بثّ الأول ⇒ يُسمع الاثنان معاً بلا قفزة في المستوى.
# 4) فصل أحدهما أثناء كلام الآخر ⇒ الآخر يبقى على الهواء بلا انقطاع.

# ===== الإخراج إلى Icecast =====
# ⬇️ تأكد أن المنفذ هنا هو نفسه <port> في icecast.xml — 8010 هو المقيس على
# السيرفر الحيّ حالياً، لا 8000 كما كان في النسخة الأولى من هذا الملف.
output.icecast(
  %mp3(bitrate = 128),
  host     = "localhost",
  port     = 8010,
  password = icecast_pass,
  mount    = "/radio",
  radio
)

# ---------------------------------------------------------------
# تحسينات اختيارية — أضفها بعد ما يشتغل الأساس، وافحص بعد كل إضافة
# بـ liquidsoap --check قبل ما تعيد تشغيل الخدمة:
#
# 1) تلاشٍ ناعم بين الأغاني — ضعه على الأغاني فقط، لا على البث المدمج:
#      music = crossfade(duration = 2.0, music)
#
# 2) تجاهل الصمت القصير من كل مذيع حتى لا تُقطع وصلته عند تلعثم الشبكة —
#    ضعه على كل مدخل على حدة قبل الخلط، لا على المتغيّر live المدمج:
#      live1 = blank.strip(max_blank = 5.0, live1)
#      live2 = blank.strip(max_blank = 5.0, live2)
# ---------------------------------------------------------------
